{
  "name": "digital-workshop",
  "version": "0.1.0",
  "description": "数字工坊 - 基于 PixiJS 的物理合成消除微信小游戏",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:wechat": "vite build --mode wechat",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "keywords": [
    "wechat-minigame",
    "pixijs",
    "matter-js",
    "physics",
    "merge",
    "puzzle"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@pixi/canvas-renderer": "^7.4.3",
    "gsap": "^3.15.0",
    "matter-js": "0.20.0",
    "pixi.js": "8.6.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/matter-js": "0.19.8",
    "@vitest/coverage-v8": "^4.1.6",
    "jsdom": "29.1.1",
    "terser": "^5.47.1",
    "typescript": "5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.6"
  }
}
